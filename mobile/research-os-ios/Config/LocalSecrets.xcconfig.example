// Copy to LocalSecrets.xcconfig. The destination is ignored by Git.
// RevenueCat public SDK keys are safe to place in an app binary, but keeping
// environment selection outside source control prevents accidental Test Store
// release configuration and keeps real project identifiers out of this repo.
RC_PUBLIC_SDK_KEY = REPLACE_WITH_REVENUECAT_PUBLIC_SDK_KEY
// Change to YES only after Customer Center is configured and manually reviewed.
RC_CUSTOMER_CENTER_REVIEWED = NO

// Supply only actual account-holder-approved public legal pages. Keep NO until
// both destinations and their content have been reviewed for this application.
RC_TERMS_URL =
RC_PRIVACY_URL =
RC_LEGAL_LINKS_REVIEWED = NO
// xcconfig treats a literal double slash as a comment, even inside quotes.
// Use an empty build-setting expansion between the slashes to preserve HTTPS:
// RC_TERMS_URL = https:/$()/REPLACE_WITH_APPROVED_HOST/terms
// RC_PRIVACY_URL = https:/$()/REPLACE_WITH_APPROVED_HOST/privacy
// These commented placeholders are syntax examples, not approved destinations.
// Leave Test Store enabled independently; this flag gates production purchases.

// Production builds also require an account-holder-reviewed evidence receipt.
// This is a completeness gate, not an automatic assertion of provider proof.
// Keep the receipt and its redacted evidence private until separately approved.
RC_RELEASE_EVIDENCE_FILE = $(SRCROOT)/Config/ReleaseEvidence/provider-review.json
